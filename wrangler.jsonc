{
  // Cloudflare Workers config — serves this site as static assets only.
  // `npm run build` produces a static export in ./out (next.config: output "export"),
  // and Cloudflare deploys that folder. Having this file present stops Wrangler from
  // auto-detecting "Next.js server" and running the OpenNext adapter (which fails for
  // a static export).
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "aaa-artists",
  "compatibility_date": "2026-07-14",
  "main": "./worker/index.js",
  "assets": {
    "directory": "./out",
    "binding": "ASSETS"
  },
  "vars": {
    "ENVIRONMENT": "production"
  },
  "ratelimits": [
    {
      "name": "CONTACT_GLOBAL_RATE_LIMIT",
      "namespace_id": "2001",
      "simple": { "limit": 120, "period": 60 }
    },
    {
      "name": "CONTACT_EMAIL_RATE_LIMIT",
      "namespace_id": "2002",
      "simple": { "limit": 5, "period": 60 }
    }
  ]
}
