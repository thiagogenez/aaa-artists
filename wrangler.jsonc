{
  // Cloudflare Workers config — serves this site as static assets only.
  // `npm run build` produces a static export in ./out (next.config: output "export"),
  // and Cloudflare deploys that folder. No server/OpenNext adapter is involved.
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "aaa-artists",
  "compatibility_date": "2026-06-24",
  "assets": {
    "directory": "./out"
  }
}
