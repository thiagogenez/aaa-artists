# Public Turnstile widget key used in the statically built form. Store the
# matching TURNSTILE_SECRET_KEY as a Cloudflare Worker secret, never in this
# file or any NEXT_PUBLIC variable.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=

# The canonical production origin is intentionally defined once in
# config/site.js. NEXT_PUBLIC_SITE_URL is not used.

# Event-source credentials for `npm run fetch:events` (scripts/fetch-artist-events.mjs).
# Local use only — the scheduled workflow reads these from GitHub Actions secrets of
# the same name. Never give either a NEXT_PUBLIC_ prefix: that would bake the secret
# into the static export. Each adapter simply skips when its key is absent.
SKIDDLE_API_KEY=
BANDSINTOWN_APP_ID=
