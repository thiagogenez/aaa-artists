node_modules/
.next/
out/
.env*
!.env.local.example
.dev.vars*
.wrangler/
*.log

# Scratch/source staging — copied into public/artists, not used by the app
img/

# Next.js auto-generated (path churns between dev/build)
next-env.d.ts
.claude/settings.local.json
.agents/
.rtk/

# Obsidian app state and local cross-agent context; never commit either
/.obsidian/
/.context/

# Generated from data/artists/*.yml by scripts/gen-artists.mjs
/data/artists.data.json

# Generated country-specific city suggestions (source: all-countries-and-cities-json)
/public/cities/

# TypeScript incremental build cache
*.tsbuildinfo

# Playwright artifacts
/playwright-report/
/test-results/

# Locally captured/rendered booking emails (npm run preview:email, npm run dev:mail)
/.preview/

# Mutation-test artifacts (npm run test:mutation)
/reports/
/.stryker-tmp/
