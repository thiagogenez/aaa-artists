{
  "name": "aaa-events",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24 <25"
  },
  "scripts": {
    "gen:artists": "node scripts/gen-artists.mjs",
    "gen:cities": "node scripts/gen-cities.mjs",
    "gen:data": "node scripts/gen-data.mjs",
    "check": "node scripts/gen-artists.mjs --check",
    "check:privacy": "node scripts/check-privacy.mjs",
    "check:production-env": "node scripts/check-production-env.mjs",
    "check:cloudflare-access": "node scripts/check-cloudflare-deployment-access.mjs",
    "check:dependencies": "npm audit --omit=dev --audit-level=high",
    "check:performance": "npm run build:test && node scripts/check-performance.mjs",
    "check:performance:report": "npm run build:test && node scripts/check-performance.mjs --report",
    "check:quality": "npm run format:check && npm run lint && npm run knip && npm run arch",
    "check:local": "npm run check:quality && npm run test:tooling",
    "check:deploy": "wrangler deploy --dry-run --env production",
    "check:deploy:staging": "wrangler deploy --dry-run --env staging",
    "check:release": "npm run check:privacy && npm test && npm run lint && npm run build:production",
    "predev": "npm run gen:data",
    "dev": "next dev",
    "prebuild": "npm run gen:data",
    "build": "next build",
    "build:test": "NEXT_PUBLIC_TURNSTILE_SITE_KEY=test-site-key NEXT_PUBLIC_E2E_DATE=2026-08-01 npm run build",
    "build:production": "npm run check:production-env && npm run build",
    "deploy": "npm run build:production && npm run deploy:built",
    "deploy:built": "wrangler deploy --env production",
    "deploy:staging": "npm run build:production && wrangler deploy --env staging",
    "deploy:dry-run": "npm run build:production && npm run check:deploy",
    "fetch:events": "node scripts/fetch-artist-events.mjs",
    "preview:email": "node scripts/preview-enquiry-email.mjs",
    "dev:mail": "node scripts/mail-catcher.mjs",
    "dev:worker": "npm run build && wrangler dev --port 8787",
    "smoke:production": "node scripts/smoke-production.mjs",
    "smoke:staging": "SMOKE_TARGET=staging node scripts/smoke-production.mjs",
    "start": "next start",
    "format": "biome format --write .",
    "format:check": "biome format .",
    "lint": "npm run lint:eslint && npm run lint:biome",
    "lint:eslint": "eslint .",
    "lint:biome": "biome lint .",
    "knip": "knip --no-progress",
    "arch": "arch-contract check",
    "arch:graph": "arch-contract graph",
    "arch:explain": "arch-contract explain",
    "test": "npm run test:worker && npm run test:events && npm run test:tooling",
    "test:worker": "node --test tests/worker/*.test.mjs",
    "test:events": "node --test tests/events/*.test.mjs",
    "test:tooling": "node --test tests/tooling/*.test.mjs",
    "test:mutation": "stryker run",
    "test:e2e": "npm run build:test && npm run test:e2e:run",
    "test:e2e:run": "playwright test",
    "test:e2e:report": "playwright show-report",
    "test:enquiry": "npm run build:test && npm run test:enquiry:run",
    "test:enquiry:run": "node scripts/check-enquiry-roundtrip.mjs",
    "test:visual": "npm run build:test && node scripts/run-visual-tests.mjs",
    "test:visual:run": "node scripts/run-visual-tests.mjs"
  },
  "dependencies": {
    "@intl-tel-input/react": "^29.2.3",
    "intl-tel-input": "^29.1.2",
    "next": "^16.3.3",
    "react": "^19.2.8",
    "react-dom": "^19.2.8"
  },
  "overrides": {
    "sharp": "^0.35.3",
    "qs": "^6.15.3"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.11",
    "@commitlint/cli": "^21.2.1",
    "@commitlint/config-conventional": "^21.2.0",
    "@stryker-mutator/core": "^9.6.1",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^24",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "all-countries-and-cities-json": "^1.0.0",
    "arch-contract": "^0.3.0",
    "eslint": "^9",
    "eslint-config-next": "^16.3.3",
    "js-yaml": "^5.4.1",
    "knip": "^6.33.0",
    "playwright": "^1.62.1",
    "tailwindcss": "^4",
    "typescript": "^5",
    "wrangler": "4.127.1"
  }
}
